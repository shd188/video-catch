# 服务监听（本机 Nginx 反代时可设 127.0.0.1:8787）
HOST=0.0.0.0
PORT=8787

# 管理后台登录密码（仅用于 /admin/ 登录，与客户激活码无关）
# 首次启动会写入数据库；之后可在后台「修改登录密码」更改，不必再改 .env
ADMIN_API_KEY=change-me-to-a-long-random-string

# 对外公开的 API 根地址（用于生成下载链接，需 https）
PUBLIC_BASE_URL=https://api.example.com

# SQLite 数据库文件路径
DATABASE_PATH=./data/licenses.db

# 发布包目录（把各渠道 zip 放这里，见 docs/SERVER.md）
RELEASES_DIR=./data/releases

# CORS：扩展 ID 或 *（开发可 *，生产建议收紧）
CORS_ORIGIN=*

# 管理后台渠道下拉（逗号分隔）
ADMIN_CHANNELS=xiaoetong
